    "node": ">=20.20.0"
  },
  "dependencies": {
    "@google-cloud/firestore": "^8.3.0",
    "@google-cloud/storage": "^7.19.0",
    "@google-cloud/vertexai": "^1.10.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "midtrans-client": "^1.4.3",
    "mongoose": "^7.0.0",
    "multer": "^2.0.2",
    "mysql2": "^3.17.4",
    "openai": "^6.22.0",
    "sequelize": "^6.37.7",
    "uuid": "^13.0.0"
  }
