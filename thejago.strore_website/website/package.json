{
  "name": "todo-app",
  "version": "1.0.0",
  "description": "E-commerce website for The Jago Snack & Frozen Food",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "build": "npm run build:frontend",
    "build:frontend": "npm --prefix ../frontend run build",
    "start:full": "npm run build:frontend && node index.js",
