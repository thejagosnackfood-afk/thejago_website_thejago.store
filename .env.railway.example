# Railway Runtime
SERVICE_NAME=thejago-whatsapp
WHATSAPP_DRY_RUN=false

# WhatsApp Gateway
WHATSAPP_GATEWAY_URL=https://your-whatsapp-gateway.example.com/send
WHATSAPP_GATEWAY_TOKEN=replace-me
WHATSAPP_GATEWAY_AUTH_HEADER=Authorization
WHATSAPP_GATEWAY_TOKEN_PREFIX=Bearer

# Supabase Server
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Supabase Public (if frontend needs it)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me

# Midtrans (Required for QRIS)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=replace-me
MIDTRANS_SERVER_KEY=replace-me
