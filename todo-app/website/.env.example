PORT=3000
MONGO_URI=mongodb://user:pass@host:27017/thejago_store

# Auth/session
SESSION_TTL_DAYS=30

# Admin seed
ADMIN_SEED_TOKEN=change-me
ADMIN_API_TOKEN=change-me-too

# WhatsApp OTP (dev only)
WHATSAPP_PROVIDER=mock
WHATSAPP_MOCK=true

# WhatsApp OTP (Fonnte)
# WHATSAPP_PROVIDER=fonnte
# FONNTE_TOKEN=
# FONNTE_COUNTRY_CODE=62
# Optional: override API URL
# FONNTE_API_URL=https://api.fonnte.com/send
# Optional: template, use {CODE} placeholder
# WHATSAPP_OTP_TEMPLATE=Kode OTP The Jago: {CODE}. Berlaku 5 menit.

# OpenAI CS
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Midtrans
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# Optional: serve built frontend
# STATIC_DIR=../frontend/dist
